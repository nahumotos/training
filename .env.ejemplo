# Copiá este archivo como .env.local y completá los valores de tu proyecto de Firebase.
# Están en Firebase Console → Configuración del proyecto → Tus apps → App web.
# Estos valores identifican al proyecto; no son secretos (la seguridad la dan las reglas de Firestore).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# URL del Worker de Cloudflare que calcula comidas con IA (opcional).
# Sin este valor, la pestaña "Foto o texto" no aparece y el resto funciona igual.
# Ejemplo: https://libreta-ia.tu-usuario.workers.dev
VITE_IA_URL=
