# Configuración FALSA, solo para las pruebas automáticas de la versión con Firebase.
# Los servidores de Google se simulan en pruebas/e2e/produccion.spec.ts.
VITE_FIREBASE_API_KEY=clave-de-prueba
VITE_FIREBASE_AUTH_DOMAIN=libreta-prueba.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=libreta-prueba
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_IA_URL=https://libreta-ia.prueba.workers.dev
