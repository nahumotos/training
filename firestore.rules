rules_version = '2';

// Reglas de acceso a los datos.
// - Cualquiera puede crear su cuenta desde la app. Cada persona lee y escribe únicamente
//   sus propios datos, en users/{uid}.
// - Qué secciones ve cada cuenta lo decide un administrador: admins/{uid} (se crea a mano
//   desde la consola de Firebase; nadie puede crearlo desde la app).
// - permitidos/{uid}: cuentas habilitadas a mano antes del registro abierto; ven todo.
// - accesos/{uid}: secciones habilitadas por un admin. Solo un admin lo escribe.
// - cuentas/{uid}: email, nombre y fechas de cada cuenta, para el panel de administración.
//   La escribe la propia cuenta; la lee ella y los admins.
// - Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return conSesion() && request.auth.uid == uid;
    }

    function esAdmin() {
      return conSesion() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function fechaIso(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function textoHasta(v, max) {
      return v is string && v.size() <= max;
    }

    // Administradores y cuentas anteriores: cada una solo puede ver si está; los admins ven la
    // lista entera. Nadie las cambia desde la app.
    match /admins/{uid} {
      allow get: if esDueno(uid) || esAdmin();
      allow list: if esAdmin();
      allow write: if false;
    }

    match /permitidos/{uid} {
      allow get: if esDueno(uid) || esAdmin();
      allow list: if esAdmin();
      allow write: if false;
    }

    // Secciones habilitadas para cada cuenta (la rutina va siempre y no se guarda acá).
    match /accesos/{uid} {
      allow get: if esDueno(uid) || esAdmin();
      allow list: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['secciones', 'actualizado'])
        && request.resource.data.secciones is list
        && request.resource.data.secciones.size() <= 3
        && request.resource.data.secciones.toSet().hasOnly(['comidas', 'progreso', 'plan'])
        && textoHasta(request.resource.data.get('actualizado', ''), 40);
      allow delete: if esAdmin();
    }

    // Ficha de cada cuenta para el panel. El email tiene que ser el de la sesión y la fecha de
    // alta no se cambia.
    match /cuentas/{uid} {
      function fichaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'nombre', 'creado', 'ultimoIngreso'])
          && d.keys().hasAll(['email', 'nombre', 'creado', 'ultimoIngreso'])
          && d.email == request.auth.token.email
          && textoHasta(d.email, 200)
          && textoHasta(d.nombre, 60)
          && textoHasta(d.creado, 40)
          && textoHasta(d.ultimoIngreso, 40);
      }
      allow get: if esDueno(uid) || esAdmin();
      allow list: if esAdmin();
      allow create: if esDueno(uid) && fichaValida();
      allow update: if esDueno(uid) && fichaValida() && request.resource.data.creado == resource.data.creado;
      allow delete: if false;
    }

    // Perfil y objetivos.
    match /users/{uid} {
      allow read, write: if esDueno(uid);

      // Un documento por día del diario (id = fecha).
      match /dias/{fecha} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && fechaIso(fecha) && request.resource.data.fecha == fecha;
      }

      // Entrenamientos (id = fecha_día-de-rutina).
      match /sesiones/{id} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9-]{1,20}$')
          && request.resource.data.id == id;
      }

      // Notas de cada semana (id = lunes de esa semana).
      match /semanas/{lunes} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && fechaIso(lunes);
      }

      // Peso de trabajo y nota por ejercicio (id = ejercicio).
      match /notas/{exId} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && exId.matches('^[A-Za-z0-9_-]{1,60}$');
      }

      // Alimentos propios.
      match /alimentos/{id} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && id.size() <= 60 && request.resource.data.id == id;
      }
    }
  }
}
