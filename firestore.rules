rules_version = '2';

// Reglas de acceso a los datos.
// - Solo entran las cuentas habilitadas: tiene que existir el documento permitidos/{uid}
//   (se crea a mano desde la consola de Firebase; nadie puede crearlo desde la app).
// - Cada persona lee y escribe únicamente sus propios datos, en users/{uid}.
// - Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function habilitado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/permitidos/$(request.auth.uid));
    }

    function esDueno(uid) {
      return habilitado() && request.auth.uid == uid;
    }

    function fechaIso(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Lista de cuentas habilitadas: cada una solo puede ver si está, nunca cambiarla.
    match /permitidos/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Perfil y objetivos.
    match /users/{uid} {
      allow read, write: if esDueno(uid);

      // Un documento por día del diario (id = fecha).
      match /dias/{fecha} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && fechaIso(fecha) && request.resource.data.fecha == fecha;
      }

      // Entrenamientos (id = fecha_día-de-rutina).
      match /sesiones/{id} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9-]{1,20}$')
          && request.resource.data.id == id;
      }

      // Notas de cada semana (id = lunes de esa semana).
      match /semanas/{lunes} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && fechaIso(lunes);
      }

      // Peso de trabajo y nota por ejercicio (id = ejercicio).
      match /notas/{exId} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && exId.matches('^[A-Za-z0-9_-]{1,60}$');
      }

      // Alimentos propios.
      match /alimentos/{id} {
        allow read, delete: if esDueno(uid);
        allow write: if esDueno(uid) && id.size() <= 60 && request.resource.data.id == id;
      }
    }
  }
}
